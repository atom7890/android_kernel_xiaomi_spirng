&soc {
	spring_restored_36: qcom,msm_gsi {
		compatible = "qcom,msm_gsi";
	};
};

&soc {
	spring_restored_37: qcom,rmnet-ipa {
		qcom,ipa-napi-enable;
		qcom,ipa-advertise-sg-support;
		qcom,ipa-platform-type-msm;
		qcom,rmnet-ipa-ssr;
		compatible = "qcom,rmnet-ipa3";
	};
};

&{/soc/qcom,smp2p-modem} {
	smp2p_wlan_1_in: qcom,smp2p-wlan-1-in {
		#interrupt-cells = <0x2>;
		interrupt-controller;
		qcom,entry-name = "wlan";
	};
};

&soc {
	msm_vidc: qcom,vidc@5a00000 {
		qcom,bus-range-kbps = <0x3e8 0x3e8 0x3e8 0x632ea0>;
		interconnects = <&bimc 0x0 &config_noc 0x22c &mmnrt_virt 0xf &bimc 0x200>;
		interconnect-names = "venus-cnoc", "venus-ddr";
		vidc,firmware-name = "venus_ecdsa";
		qcom,reg-presets = <0xb0080 0x0 0x3>;
		qcom,allowed-clock-rates = <0x7ed6b40 0xe4e1c00 0x11e1a300 0x16e36000>;
		qcom,clock-configs = <0x1 0x0 0x1 0x0 0x0>;
		qcom,proxy-clock-names = "core_clk", "bus_clk", "core0_clk", "core0_bus_clk", "throttle_clk";
		clocks = <&gcc 0xba &gcc 0xb4 &gcc 0xb8 &gcc 0xb2 &gcc 0xb7>;
		clock-ids = <0xba 0xb4 0xb8 0xb2 0xb7>;
		clock-names = "core_clk", "bus_clk", "core0_clk", "core0_bus_clk", "throttle_clk";
		venus-core0-supply = <&gcc_vcodec0_gdsc>;
		venus-supply = <&gcc_venus_gdsc>;
		#size-cells = <0x1>;
		#address-cells = <0x1>;
		pas-id = <0x9>;
		memory-region = <&pil_video_mem>;
		interrupts = <0x0 0xe1 0x4>;
		reg = <0x5a00000 0x200000>;
		status = "okay";
		compatible = "qcom,msm-vidc", "qcom,msm-vidc-blair", "qcom,msm-vidc-ar50lt";
		spring_restored_40: non_secure_cb {
			virtual-addr-pool = <0x70800000 0x6f800000>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-dma-addr-pool = <0x70800000 0x6f800000>;
			iommus = <&apps_smmu 0xc60 0x0 &apps_smmu 0xc80 0x0>;
			label = "venus_ns";
			compatible = "qcom,msm-vidc,context-bank";
		};
		spring_restored_41: secure_bitstream_cb {
			qcom,secure-context-bank;
			virtual-addr-pool = <0x4b000000 0x25800000>;
			qcom,iommu-vmid = <0x9>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-dma-addr-pool = <0x4b000000 0x25800000>;
			iommus = <&apps_smmu 0xc61 0x4>;
			label = "venus_sec_bitstream";
			compatible = "qcom,msm-vidc,context-bank";
		};
		spring_restored_42: secure_non_pixel_cb {
			qcom,secure-context-bank;
			virtual-addr-pool = <0x1000000 0x24800000>;
			qcom,iommu-vmid = <0xb>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-dma-addr-pool = <0x1000000 0x24800000>;
			iommus = <&apps_smmu 0xc04 0xe0>;
			label = "venus_sec_non_pixel";
			compatible = "qcom,msm-vidc,context-bank";
		};
		spring_restored_43: secure_pixel_cb {
			qcom,secure-context-bank;
			virtual-addr-pool = <0x25800000 0x25800000>;
			qcom,iommu-vmid = <0xa>;
			qcom,iommu-faults = "non-fatal";
			qcom,iommu-dma-addr-pool = <0x25800000 0x25800000>;
			iommus = <&apps_smmu 0xc63 0x0>;
			label = "venus_sec_pixel";
			compatible = "qcom,msm-vidc,context-bank";
		};
	};
};
