/*
 * Recovered from the confirmed working Spring DTB supplied in
 * infinity-17/device/xiaomi/spring-kernel/images (2026-11-06).
 * Missing platform sources are not present in this source checkout.
 * References are symbolic; no working-image phandle numbers are retained.
 */

&tlmm {
	spring_restored_0: nfc {
		nfc_enable_active: nfc_enable_active {
			spring_restored_2: config {
				bias-disable;
				drive-strength = <0x2>;
				pins = "gpio6", "gpio8", "gpio7";
			};
			spring_restored_3: mux {
				function = "gpio";
				pins = "gpio6", "gpio8", "gpio7";
			};
		};
		nfc_enable_suspend: nfc_enable_suspend {
			spring_restored_5: config {
				bias-disable;
				drive-strength = <0x2>;
				pins = "gpio6", "gpio8", "gpio7";
			};
			spring_restored_6: mux {
				function = "gpio";
				pins = "gpio6", "gpio8", "gpio7";
			};
		};
		nfc_int_active: nfc_int_active {
			spring_restored_8: config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio9";
			};
			spring_restored_9: mux {
				function = "gpio";
				pins = "gpio9";
			};
		};
		nfc_int_suspend: nfc_int_suspend {
			spring_restored_11: config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio9";
			};
			spring_restored_12: mux {
				function = "gpio";
				pins = "gpio9";
			};
		};
	};
};

&soc {
	icnss: qcom,icnss@C800000 {
		qcom,vdd-3.3-ch0-config = <0x2dc6c0 0x328980>;
		qcom,vdd-3.3-ch1-config = <0x2dc6c0 0x328980>;
		qcom,vdd-cx-mx-config = <0x9c400 0x9c400>;
		vdd-smps-supply = <&S5A>;
		vdd-3.3-ch0-supply = <&L23A>;
		vdd-3.3-ch1-supply = <&L21A>;
		vdd-1.3-rfa-supply = <&L2A>;
		vdd-1.8-xo-supply = <&L16A>;
		vdd-cx-mx-supply = <&L2E>;
		qcom,iommu-geometry = <0xa0000000 0x10010000>;
		qcom,iommu-dma-addr-pool = <0xa0000000 0x10000000>;
		qcom,wlan-msa-fixed-region = <&pil_wlan_mem>;
		qcom,wlan;
		qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
		qcom,iommu-dma = "fastmap";
		interrupts = <0x0 0x166 0x4 0x0 0x167 0x4 0x0 0x168 0x4 0x0 0x169 0x4 0x0 0x16a 0x4 0x0 0x16b 0x4 0x0 0x16c 0x4 0x0 0x16d 0x4 0x0 0x16e 0x4 0x0 0x16f 0x4 0x0 0x170 0x4 0x0 0x171 0x4>;
		iommus = <&apps_smmu 0x80 0x1>;
		reg-names = "membase", "smmu_iova_ipa";
		reg = <0xc800000 0x800000 0xb0000000 0x10000>;
		compatible = "qcom,icnss";
		spring_restored_14: qcom,smp2p_map_wlan_1_in {
			interrupt-names = "qcom,smp2p-force-fatal-error", "qcom,smp2p-early-crash-ind";
			interrupts-extended = <&smp2p_wlan_1_in 0x0 0x0 &smp2p_wlan_1_in 0x1 0x0>;
		};
	};
};

&soc {
	ipa_hw: qcom,ipa@0x5800000 {
		qcom,scaling-exceptions;
		qcom,throughput-threshold = <0x258 0x9c4 0x1388>;
		qcom,bus-vector-names = "MIN", "SVS2", "SVS", "NOMINAL", "TURBO";
		qcom,turbo = <0x324b0 0x556eb4 0x324b0 0x15eb41 0x324b0 0x78000>;
		qcom,nominal = <0x324b0 0x3d0900 0x324b0 0xae101 0x324b0 0x78000>;
		qcom,svs = <0x13880 0x1e8480 0x13880 0x414c5 0x13880 0x1ad42>;
		qcom,svs2 = <0x13880 0x71868 0x13880 0x10bda 0x13880 0x1e>;
		qcom,no-vote = <0x0 0x0 0x0 0x0 0x0 0x0>;
		interconnect-names = "ipa_to_ebi1", "ipa_to_imem", "appss_to_ipa";
		interconnects = <&system_noc 0x1d &bimc 0x200 &system_noc 0x1d &system_noc 0x232 &bimc 0x0 &config_noc 0x218>;
		qcom,interconnect,num-paths = <0x3>;
		qcom,interconnect,num-cases = <0x5>;
		qcom,max_num_smmu_cb = <0x4>;
		clocks = <&rpmcc 0x44>;
		clock-names = "core_clk";
		qcom,tx-wrapper-cache-max-size = <0x190>;
		qcom,wan-rx-ring-size = <0xc0>;
		qcom,ipa-endp-delay-wa;
		qcom,rmnet-ctl-enable;
		qcom,wan-use-skb-page;
		qcom,lan-rx-napi;
		qcom,use-64-bit-dma-mask;
		qcom,arm-smmu;
		qcom,ipa-wdi2_over_gsi;
		qcom,ipa-wdi2;
		qcom,modem-cfg-emb-pipe-flt;
		qcom,use-ipa-tethering-bridge;
		qcom,ee = <0x0>;
		qcom,platform-type = <0x1>;
		qcom,ipa-hw-mode = <0x0>;
		qcom,ipa-hw-ver = <0x14>;
		interrupt-names = "ipa-irq", "gsi-irq";
		interrupts = <0x0 0x101 0x4 0x0 0x103 0x4>;
		memory-regions = <&pil_ipa_fw_mem>;
		firmware-names = "ipa_fws";
		pas-ids = <0xf>;
		reg-names = "ipa-base", "gsi-base";
		reg = <0x5800000 0x84000 0x5804000 0x23000>;
		compatible = "qcom,ipa";
		ipa_smmu_11ad: ipa_smmu_11ad {
			qcom,iommu-group;
			qcom,shared-cb;
			iommus = <&apps_smmu 0x4a3 0x0>;
			compatible = "qcom,ipa-smmu-11ad-cb";
		};
		ipa_smmu_ap: ipa_smmu_ap {
			qcom,ipa-q6-smem-size = <0x9000>;
			qcom,iommu-dma = "atomic";
			qcom,additional-mapping = <0xc123000 0xc123000 0x2000>;
			qcom,iommu-dma-addr-pool = <0x20000000 0x20000000>;
			iommus = <&apps_smmu 0x4a0 0x0>;
			compatible = "qcom,ipa-smmu-ap-cb";
		};
		ipa_smmu_uc: ipa_smmu_uc {
			qcom,iommu-dma = "atomic";
			qcom,iommu-dma-addr-pool = <0x20000000 0x20000000>;
			iommus = <&apps_smmu 0x4a2 0x0>;
			compatible = "qcom,ipa-smmu-uc-cb";
		};
		ipa_smmu_wlan: ipa_smmu_wlan {
			qcom,iommu-dma = "atomic";
			iommus = <&apps_smmu 0x4a1 0x0>;
			compatible = "qcom,ipa-smmu-wlan-cb";
		};
		spring_restored_20: qcom,smp2p_map_ipa_1_in {
			interrupt-names = "ipa-smp2p-in";
			interrupts-extended = <&smp2p_ipa_1_in 0x0 0x0>;
			compatible = "qcom,smp2p-map-ipa-1-in";
		};
		spring_restored_21: qcom,smp2p_map_ipa_1_out {
			qcom,smem-state-names = "ipa-smp2p-out";
			qcom,smem-states = <&smp2p_ipa_1_out 0x0>;
			compatible = "qcom,smp2p-map-ipa-1-out";
		};
	};
};

&soc {
	spring_restored_22: qcom,ipa_fws {
		status = "disabled";
		memory-region = <&pil_ipa_fw_mem>;
		qcom,pil-force-shutdown;
		qcom,firmware-name = "ipa_fws";
		qcom,pas-id = <0xf>;
		compatible = "qcom,pil-tz-generic";
	};
};

