load("//build/kernel/kleaf:kernel.bzl", "ddk_module")
load("//build/bazel_common_rules/dist:dist.bzl", "copy_to_dist_dir")

ddk_module(
    name = "spring_gki_sla",
    srcs = [
        "stats.c",
        "sla_stats.h",
    ],
    out = "sla.ko",
    kernel_build = "//msm-kernel:spring_gki",
    deps = ["//msm-kernel:all_headers"],
)

copy_to_dist_dir(
    name = "spring_gki_sla_dist",
    data = [":spring_gki_sla"],
    flat = True,
    wipe_dist_dir = False,
    allow_duplicate_filenames = False,
)
