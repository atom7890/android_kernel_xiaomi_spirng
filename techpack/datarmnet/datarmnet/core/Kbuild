endif

ifeq ($(KBUILD_EXTMOD),)
ccflags-y += -I$(srctree)/$(src) -DRMNET_TRACE_INCLUDE_PATH=.
ccflags-y += -I$(srctree)/techpack/dataipa/dataipa/drivers/platform/msm/include \
	-I$(srctree)/techpack/dataipa/dataipa/drivers/platform/msm/include/uapi \
	-I$(srctree)/techpack/datarmnet-ext/datarmnet-ext/mem
else
ccflags-y += \
	-I$(src)/../../dataipa/drivers/platform/msm/include \
	-I$(src)/../../dataipa/drivers/platform/msm/include/uapi \
	-I$(src)/../../datarmnet-ext/mem
endif

obj-m += rmnet_core.o

